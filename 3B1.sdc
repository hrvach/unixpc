derive_pll_clocks
derive_clock_uncertainty

# core specific constraints
#
# First Quartus run (17.1 Lite): the system domain (20 MHz) passed with 13.8 ns slack; the SDRAM data input paths needed the multicycle below.
#
# clk_sys (20 MHz, pll outclk_0) and the SDRAM controller clock (100 MHz, outclk_1) come from the same PLL, but every crossing between
# them is a toggle handshake (rtl/ram/sdram_bridge.sv: req_tog / ack_tog through two flip flops, payload held stable until the
# acknowledge), so the two domains are treated as asynchronous.
set_clock_groups -asynchronous \
    -group [get_clocks {*|pll|pll_inst|altera_pll_i|*[0].*|divclk}] \
    -group [get_clocks {*|pll|pll_inst|altera_pll_i|*[1].*|divclk}] \
    -group [get_clocks {*|pll|pll_inst|altera_pll_i|*[2].*|divclk}]

# SDRAM_CLK is generated by an altddio_out from the 100 MHz clock inside sdram.sv (inverted clock).
create_generated_clock -name SDRAM_CLK -source [get_pins {emu|pll|pll_inst|altera_pll_i|*[1].*|divclk}] -invert [get_ports {SDRAM_CLK}]
set_input_delay  -clock SDRAM_CLK -max 6.4 [get_ports {SDRAM_DQ[*]}]
set_input_delay  -clock SDRAM_CLK -min 3.2 [get_ports {SDRAM_DQ[*]}]
set_output_delay -clock SDRAM_CLK -max 1.5 [get_ports {SDRAM_DQ[*] SDRAM_A[*] SDRAM_BA[*] SDRAM_nCS SDRAM_nCAS SDRAM_nRAS SDRAM_nWE SDRAM_CKE SDRAM_DQML SDRAM_DQMH}]
set_output_delay -clock SDRAM_CLK -min -0.8 [get_ports {SDRAM_DQ[*] SDRAM_A[*] SDRAM_BA[*] SDRAM_nCS SDRAM_nCAS SDRAM_nRAS SDRAM_nWE SDRAM_CKE SDRAM_DQML SDRAM_DQMH}]

# Read data: SDRAM_CLK is the inverted controller clock, so the chip sees a command half a controller clock after the controller edge that launched it. With
# CAS latency 2 it drives the data 2.5 controller clocks after that edge, plus clock-to-pad, tAC (3.2 .. 6.4 ns in the delays above) and the input pad delay.
# sdram.sv therefore registers the word on the FOURTH controller edge after the READ (data_ready_delay has CAS_LATENCY+1 stages; the original sdram16 used the third,
# which only works when the total delay is below 5 ns; tb/sdram/tb_sdram.sv with DLY sweeps this: the controller works for 5 .. 14 ns of total delay).
# In STA terms the word is captured on the second controller edge after the SDRAM_CLK edge that launches it: setup gets 15 ns instead of 5 ns. The hold check keeps
# its default relationship (new data must not arrive before the previous word was captured), which is the check that is wanted for this scheme.
set_multicycle_path -setup 2 -from [get_clocks {SDRAM_CLK}] -to [get_clocks {*|pll|pll_inst|altera_pll_i|*[1].*|divclk}]
